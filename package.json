{
  "name": "sitesurveyorsdk",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/*",
    "ai-gateway",
    "ai-gateway/sitesurveyor-mcp",
    "scripts/ai-eval"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@sitesurveyor/web",
    "dev:web": "turbo run dev --filter=@sitesurveyor/web",
    "dev:desktop": "turbo run dev --filter=@sitesurveyor/desktop",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@sitesurveyor/web",
    "build:desktop": "turbo run build --filter=@sitesurveyor/desktop",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "supabase": "npx supabase",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "functions:deploy": "npx supabase functions deploy",
    "ai:eval": "node scripts/ai-eval/run.ts",
    "ai:skills-check": "node scripts/ai-eval/skills-check.ts",
    "ai:memory-check": "node scripts/ai-eval/memory-check.ts",
    "ai:models-check": "node scripts/ai-eval/models-check.ts",
    "ai:rounds-check": "node scripts/ai-eval/rounds-check.ts"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "supabase": "^2.98.0",
    "turbo": "^2.11.11"
  },
  "allowScripts": {
    "supabase@2.98.0": true
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
