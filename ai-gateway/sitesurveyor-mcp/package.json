{
  "name": "sitesurveyor-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SiteSurveyor MCP server — exposes the SiteSurveyor AI agent's data, CAD, memory and workflow tools to OpenClaw and any MCP-capable agent runtime via stdio.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
