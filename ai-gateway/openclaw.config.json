{
  "env": {
    "vars": {
      "SITESURVEYOR_SUPABASE_URL": "${SUPABASE_URL}",
      "SITESURVEYOR_SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
      "SITESURVEYOR_WORKSPACE_ID": "${SITESURVEYOR_WORKSPACE_ID:-}"
    }
  },
  "models": {
    "providers": {
      "Thinking Machines AI": {
        "baseUrl": "https://api.thinkingmachines.ai/v1",
        "apiKey": {
          "source": "env",
          "provider": "env",
          "id": "THINKING_MACHINES_AI_API_KEY"
        },
        "auth": "api-key",
        "api": "openai-completions"
      }
    }
  },
  "mcp": {
    "servers": {
      "sitesurveyor": {
        "command": "node",
        "args": ["./sitesurveyor-mcp/dist/index.js"],
        "cwd": ".",
        "transport": "stdio",
        "env": {
          "SUPABASE_URL": "${SITESURVEYOR_SUPABASE_URL}",
          "SITESURVEYOR_SUPABASE_SERVICE_ROLE_KEY": "${SITESURVEYOR_SUPABASE_SERVICE_ROLE_KEY}",
          "SITESURVEYOR_WORKSPACE_ID": "${SITESURVEYOR_WORKSPACE_ID}"
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "."
    },
    "entries": {
      "sitesurveyor": {
        "name": "SiteSurveyor",
        "description": "SiteSurveyor surveying project assistant configured for Thinking Machines AI (Inkling) Gateway.",
        "model": "inkling"
      }
    }
  }
}
