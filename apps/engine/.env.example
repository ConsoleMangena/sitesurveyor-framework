# Local secrets — never commit.
#
# The survey worker is the only thing that runs in production. The engine's MCP server
# remains for driving the pipeline by hand from an agent while developing.

# Coverage access for Digital Earth Africa.
DEAFRICA_SANDBOX_API_KEY=your_de_africa_token_here

# Where the survey cache and rendered outputs live. Point this at a persistent disk: a
# survey that re-downloads six coverages over an AOI it already fetched is the whole
# difference between minutes and tens of minutes.
# SITESURVEYOR_STATE_DIR=/app/state

# ── Worker ──
# The worker claims rows from `survey_runs` and publishes results back, so it needs the
# project's privileged key. It is restricted by grants in
# supabase/migrations/20261106150000_satellite_surveys.sql to the four survey RPCs and
# the deliverables bucket — it is not a general database admin token, and it never
# reaches a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SURVEY_POLL_SECONDS=10
# SURVEY_DELIVERABLES_BUCKET=survey-deliverables
