VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── SiteSurveyor AI agent ──
# The AI chat runs on the `ai-chat` Supabase Edge Function — no frontend env
# vars needed. Models are NVIDIA NIM Nemotron ids in `nvidia/<model>` form
# (see build.nvidia.com/models); the allowlist lives in
# supabase/functions/_shared/models.ts. Deploy with:
#   supabase functions deploy ai-chat
#   supabase secrets set NVIDIA_API_KEY=nvapi-...
# Only models entitled to the key's account may be listed — an unentitled id
# fails at call time with 404 "Function not found for account".
# Optional offline fallback: the host server (ai-gateway/) exposes /api/chat
# with the same contract when configured via ai-gateway/.env.

# ── Satellite survey maps ──
# The zoomable classified map reads its PMTiles archive as byte ranges through
# the `deliverable-file` Edge Function (private bucket, no signed-URL ranges).
# Deploy after the schema/worker setup:
#   supabase functions deploy deliverable-file

# Optional: show the Platform Administration signup card on the signup page.
# Default is hidden (off). Set to "true" to expose the card.
# VITE_ENABLE_PLATFORM_ADMIN_SIGNUP=true

# ── Desktop shell ──
# Origin of the hosted web build. The desktop shell finishes GitHub sign-in,
# email confirmation and password reset in the system browser, and that browser
# can only be redirected to a URL the Supabase project allowlists — the shell's
# own origin (`http://tauri.localhost`) can never be one of them. So the
# browser is sent back to a bridge page on this origin, which hands the result
# to the app over `sitesurveyor://app`. Defaults to https://sitesurveyor.tech.
# VITE_PUBLIC_APP_URL=https://sitesurveyor.tech

# ── Solana on-chain payments (USDC) ──
# Network to settle payments on. devnet for development/demo, mainnet-beta for live.
VITE_SOLANA_CLUSTER=devnet
# Optional custom RPC endpoint. Defaults to the public cluster RPC if unset.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC SPL mint for the selected cluster. Defaults to Circle's mint per cluster.
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# VITE_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Treasury wallet (base58) that receives all payments. REQUIRED to enable the
# "Pay with Phantom" button. Leave empty to hide on-chain payments.
VITE_SOLANA_TREASURY_ADDRESS=
